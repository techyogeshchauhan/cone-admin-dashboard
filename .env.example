PORT=8080
APP_ENV=development
ADMIN_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=conferencemanagement-239a3
# Use Application Default Credentials or an absolute service-account file path.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
STORAGE_ROOT=./storage
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-account@gmail.com
# Gmail: an App Password (Google Account > Security > App passwords).
SMTP_PASSWORD=
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=CONE
# Production must require MFA; enroll privileged users in Firebase first.
REQUIRE_ADMIN_MFA=true
# Generate a long random secret; rotating this invalidates existing signed passes.
PASS_SIGNING_SECRET=
# Base64-encoded 32-byte key for encrypted SMTP credentials saved in the panel.
CONFIG_ENCRYPTION_KEY=
VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=AIzaSyBAK6SABsnvyj8o4A47Urw7NVkunvZTW1U
VITE_FIREBASE_AUTH_DOMAIN=conferencemanagement-239a3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=conferencemanagement-239a3
VITE_FIREBASE_APP_ID=1:743439294151:web:972c729ba887bb05ba28e2
# Optional local Firebase emulators; never set these for production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_STORAGE_BUCKET=conferencemanagement-239a3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=743439294151
# Explicit local-only access for marked dashboard test accounts.
ENABLE_ADMIN_TEST_ACCOUNTS=true
ENABLE_DASHBOARD_ROLE_LOGIN=true
VITE_ENABLE_DASHBOARD_ROLE_LOGIN=true
# Local testing only. Never enable in production.
TEST_IN_APP_EMAIL_VERIFICATION=true
# For ADC without a private signing key, set a service-account identity.
# The caller must already have iam.serviceAccounts.signBlob on this account.
FIREBASE_SERVICE_ACCOUNT_ID=firebase-adminsdk-fbsvc@conferencemanagement-239a3.iam.gserviceaccount.com
# Mobile email-OTP sign-in (Flutter app). The secret stays server-only.
OTP_AUTH_ENABLED=true
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OTP_HMAC_SECRET=
# Listen on the network so a phone on the same Wi-Fi can reach the OTP API.
HOST=0.0.0.0
# Folder of the separate Flutter app repository (used by verify:test-accounts).
# APP_REPO_DIR=../Cone
