# Optional numeric-email-OTP mode. Current .env is not changed by this template.
OTP_AUTH_ENABLED=false
# Generate a random server-only base64 secret of 32+ bytes before enabling.
OTP_HMAC_SECRET=
# Listen beyond this computer so the mobile app can reach /api/auth/email-otp.
# HOST=0.0.0.0
# Production must disable all development authentication bypasses.
# TEST_IN_APP_EMAIL_VERIFICATION=false
# ENABLE_DASHBOARD_ROLE_LOGIN=false
# ENABLE_ADMIN_TEST_ACCOUNTS=false
